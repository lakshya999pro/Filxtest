# ─────────────────────────────────────────────────────────────────────────────
# TeraBox Auto Uploader — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# TurboViPlay API Key — add yours here
TURBOVIPLAY_API_KEY=RunD6MkNhV


# Server port
PORT=3000

# Queue: how many videos to upload in parallel
QUEUE_CONCURRENCY=2

# Retry: how many times to retry a failed step
RETRY_ATTEMPTS=3

# Retry: base delay in ms (multiplied by attempt number = exponential back-off)
RETRY_DELAY_MS=5000

# Which page to fetch from the video source API
VIDEO_SOURCE_PAGE=10

# Folder name for uploaded videos on TurboViPlay
UPLOAD_FOLDER=Porn video
